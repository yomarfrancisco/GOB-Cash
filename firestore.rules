rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users/{userId}
    match /users/{userId} {
      // Allow authenticated users to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to create their own document
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to update their own document
      // Specifically allow handle repair and other self-updates
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to delete their own document (optional, for account deletion)
      // allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Wallets subcollection: users/{userId}/wallets/{walletId}
    match /users/{userId}/wallets/{walletId} {
      // Allow authenticated users to read their own wallets
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to create their own wallets
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to update their own wallets
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to delete their own wallets
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/depositProofs/{proofId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == 'uploaded';
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == resource.data.status;
      allow delete: if request.auth != null && request.auth.uid == userId
        && resource.data.status != 'credited';
    }
    
    // Contacts subcollection: users/{userId}/contacts/{contactId}
    match /users/{userId}/contacts/{contactId} {
      // Allow authenticated users to read their own contacts
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to create their own contacts
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to update their own contacts
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to delete their own contacts
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Activity events: users/{userId}/activityEvents/{eventId}
    match /users/{userId}/activityEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Transactions collection: transactions/{txId}
    match /transactions/{txId} {
      // Allow read if user is a participant (userId/senderId or receiverId or in participants array)
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        request.auth.uid in resource.data.get('participants', [])
      );
      
      // Client cannot write transactions directly (Cloud Functions only via Admin SDK)
      allow write: if false;
      
      // Messages subcollection: transactions/{txId}/messages/{msgId}
      match /messages/{msgId} {
        // Allow read if user is a participant in parent transaction
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(txId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(txId)).data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(txId)).data.receiverId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/transactions/$(txId)).data.get('participants', [])
        );
        
        // Client cannot write messages directly (Cloud Functions only)
        allow write: if false;
      }
      
      // Proofs subcollection: transactions/{txId}/proofs/{proofId}
      match /proofs/{proofId} {
        // Allow read if user is a participant in parent transaction
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(txId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(txId)).data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(txId)).data.receiverId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/transactions/$(txId)).data.get('participants', [])
        );
        
        // Client cannot write proofs directly (Cloud Functions only)
        allow write: if false;
      }
      
      // Actions subcollection: transactions/{txId}/actions/{actionId}
      // Used for action queue pattern (bypasses CORS by using Firestore writes instead of callables)
      match /actions/{actionId} {
        // Allow read if user is the transaction owner
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(txId)).data.userId == request.auth.uid
        );
        
        // Allow create if user is the transaction owner and action has required fields
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/transactions/$(txId)).data.userId == request.auth.uid &&
          request.resource.data.type is string &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'PENDING'
        );
        
        // Disallow updates/deletes by clients (server trigger will update status)
        allow update: if false;
        allow delete: if false;
      }
    }
    
    // Withdrawals collection: withdrawals/{withdrawalId}
    match /withdrawals/{withdrawalId} {
      // Allow read if user is the userId or receiverId from the linked transaction
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      
      // Client cannot write withdrawals directly (Cloud Functions only)
      allow write: if false;
    }
    
    // Public directory collection: publicDirectory/{handle}
    // Public read-only collection for contact discovery (works pre-auth)
    // Contains only non-sensitive fields: handle, displayName, avatarUrl, phoneCountry, isAgent, etc.
    match /publicDirectory/{handle} {
      // Allow anyone to read public directory entries (pre-auth included)
      allow read: if true;
      
      // Client cannot write publicDirectory directly (Cloud Functions only via Admin SDK)
      allow write: if false;
    }
    
    // Private directory collection: directoryPrivate/{handle}
    // Contains sensitive fields: email, phoneE164
    // Readable only when authenticated
    match /directoryPrivate/{handle} {
      // Allow authenticated users to read private directory entries
      allow read: if request.auth != null;
      
      // Client cannot write directoryPrivate directly (Cloud Functions only via Admin SDK)
      allow write: if false;
    }
    
    // Global network directory: globalDirectoryPrivate/{key}
    // Deduped global directory of all contacts contributed by users
    // Key = SHA256 hash of normalized email or phone
    // Contains sensitive fields: email, phoneE164, displayName
    // Readable only when authenticated
    match /globalDirectoryPrivate/{key} {
      // Allow authenticated users to read global directory entries (for search by email/phone)
      allow read: if request.auth != null;
      
      // Client cannot write globalDirectoryPrivate directly (Cloud Functions only via Admin SDK)
      allow write: if false;
    }
    
    // Global contacts public collection: globalContactsPublic/{handle}
    // Public read-only collection for contact discovery (works pre-auth)
    // Contains non-sensitive fields: handle, displayName, sources
    match /globalContactsPublic/{handle} {
      // Allow anyone to read public global contacts (pre-auth included)
      allow read: if true;
      
      // Client cannot write globalContactsPublic directly (Cloud Functions only via Admin SDK)
      allow write: if false;
    }
    
    // Global contacts private collection: globalContactsPrivate/{handle}
    // Contains sensitive fields: primaryEmail, primaryPhone
    // Readable only when authenticated
    match /globalContactsPrivate/{handle} {
      // Allow authenticated users to read private global contacts
      allow read: if request.auth != null;
      
      // Client cannot write globalContactsPrivate directly (Cloud Functions only via Admin SDK)
      allow write: if false;
    }
    
    // Legacy directory collection: directory/{handle}
    // Deprecated - kept for backward compatibility during migration
    match /directory/{handle} {
      // Allow anyone to read directory entries (public contact discovery)
      allow read: if true;
      
      // Client cannot write directory directly (Cloud Functions only)
      allow write: if false;
    }
    
    // Graph edges collection: graphEdges/{edgeId}
    // Allow authenticated users to read edges where they are the source
    match /graphEdges/{edgeId} {
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid
      );
      
      // Client cannot write graph edges directly (Cloud Functions only)
      allow write: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

